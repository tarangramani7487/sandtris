{
  "expo": {
    "name": "Grainfall",
    "slug": "grainfall",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.grainfall.game"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4A12A6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.grainfall.game"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Grainfall",
      "backgroundColor": "#4A12A6"
    },
    "plugins": [
      "expo-audio",
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#4A12A6"
        }
      ]
    ],
    "backgroundColor": "#4A12A6"
  }
}
